{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Codex review findings",
  "type": "object",
  "additionalProperties": false,
  "required": ["summary", "findings", "residual_risks"],
  "properties": {
    "summary": {
      "type": "string"
    },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "severity",
          "category",
          "file",
          "title",
          "description",
          "status"
        ],
        "properties": {
          "id": {"type": "string"},
          "severity": {
            "type": "string",
            "enum": ["Critical", "High", "Medium", "Low"]
          },
          "category": {
            "type": "string",
            "enum": [
              "security",
              "bug",
              "typing",
              "architecture",
              "testing",
              "performance",
              "compatibility",
              "convention"
            ]
          },
          "file": {"type": "string"},
          "lines": {"type": "string"},
          "title": {"type": "string"},
          "description": {"type": "string"},
          "suggestion": {"type": "string"},
          "impact": {"type": "string"},
          "effort": {
            "type": "string",
            "enum": ["trivial", "small", "medium", "large"]
          },
          "status": {
            "type": "string",
            "enum": ["pending", "approved", "fixed", "skipped", "wont-fix"]
          }
        }
      }
    },
    "residual_risks": {
      "type": "array",
      "items": {"type": "string"}
    }
  }
}
